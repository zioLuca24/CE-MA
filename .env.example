# Environment variables template for Render deployment
# Copia i valori dal tuo database Render PostgreSQL

# ===== Render Database (PostgreSQL) =====
# Prendi questi valori dal Render Dashboard → PostgreSQL Database
DATABASE_URL=postgresql://gestionale_user:YOUR_PASSWORD@dpg-xxxxxx.render.com:5432/gestionale_edile_prod
DB_USER=gestionale_user
DB_PASSWORD=YOUR_PASSWORD_HERE

# ===== Application Settings =====
SPRING_PROFILES_ACTIVE=prod
PORT=8080
JAVA_OPTS=-Xmx512m -Xms256m

# ===== Optional: Logging Level =====
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EDILE=INFO
LOGGING_LEVEL_HIBERNATE_SQL=INFO

# ===== File Upload Settings =====
MULTIPART_MAX_FILE_SIZE=50MB
MULTIPART_MAX_REQUEST_SIZE=50MB
